#!/bin/sh
set -eu
cd -- "$(dirname -- "$0")/.."
uv run python -m unittest discover -s tests -v
uv run python -m compileall -q xangi_feed scripts tests
if [ -d release-scripts ]; then uv run python -m compileall -q release-scripts; fi
for script in public/*.js; do node --check "$script"; done
node --test tests/bookmarklet.test.mjs
if [ "$(git rev-parse --show-toplevel 2>/dev/null || true)" = "$PWD" ]; then git diff --check; fi
